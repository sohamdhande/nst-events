{
  "name": "@nst/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'Prisma generate stub - run pnpm prisma generate when schema added'",
    "dev": "echo 'Prisma dev stub'",
    "lint": "echo 'No lint rules yet'",
