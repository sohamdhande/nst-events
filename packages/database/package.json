    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0"
  },
  "devDependencies": {
    "@nst/config": "workspace:*",
    "@types/node": "^20.14.0",
    "prisma": "^5.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
