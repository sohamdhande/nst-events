{
  "name": "nst-events",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "validate:local": "turbo run lint typecheck",
    "validate:ci": "turbo run lint typecheck test test:e2e build"
  },
  "devDependencies": {
    "@nst/config": "workspace:*",
    "@types/sinon": "^22.0.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "sinon": "^22.1.0",
    "turbo": "2.10.11"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^30.0.1",
    "prisma": "5.22.0",
    "vitest": "^4.1.11"
  }
}
