{
  "name": "@nst/api",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --require ./tests/setup.ts --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "EXPO_ACCESS_TOKEN=mock_token_for_tests ts-node --require ./tests/setup.ts tests/notification-e2e.test.ts"
  },
  "dependencies": {
    "@nst/database": "workspace:*",
    "@nst/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "8.6.2",
    "google-auth-library": "9.15.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nst/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/pg": "8.20.4",
    "@types/supertest": "7.2.1",
    "expo-server-sdk": "3.15.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
