{
  "name": "@nst/api",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --require ./tests/setup.ts --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "EXPO_ACCESS_TOKEN=mock_token_for_tests ts-node --require ./tests/setup.ts tests/notification-e2e.test.ts"
  },
  "dependencies": {
    "@nst/database": "workspace:*",
    "@nst/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "google-auth-library": "11.0.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nst/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "7.2.1",
    "cookie-signature": "^1.2.2",
    "expo-server-sdk": "7.1.0",
    "pino-pretty": "13.1.3",
    "sinon": "^22.1.0",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  }
}
