# ==========================================
# nst-events Environment Variables Example
# All values below are placeholders
# ==========================================

# Database Configuration (PostgreSQL + pgmq)
DATABASE_URL="postgresql://nst_app:nst_app_password@localhost:5432/nst_events?schema=public"
WORKER_DATABASE_URL="postgresql://nst_worker:nst_worker_password@localhost:5432/nst_events?schema=public"

# API & Security
PORT=3001
NODE_ENV="development"
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long
COOKIE_SECRET=super_secret_cookie_key_that_is_at_least_32_characters_long

# Google OAuth Credentials
GOOGLE_CLIENT_ID="placeholder-google-client-id"
GOOGLE_CLIENT_SECRET="placeholder-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# API Restrictions
ALLOWED_EMAIL_DOMAINS="adypu.edu.in,newtonschool.co"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Notifications (Expo Push / pgmq)
EXPO_ACCESS_TOKEN="placeholder-expo-access-token"

# Admin Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="NST Events Dashboard"
WEB_APP_URL="http://localhost:3000"

# Mobile App
EXPO_PUBLIC_API_URL="http://localhost:3001"
